# Public HTTPS origin forwarded to Companion Web.
PUBLIC_ORIGIN=https://wallet.example.com

# Expo embeds this public endpoint in the mobile application.
# It must match PUBLIC_ORIGIN. Never put secrets in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_COMPANION_ORIGIN=https://wallet.example.com

# Server-only credential used by the wallet and Issuer desk for demo operations.
OPERATOR_TOKEN=replace-with-a-long-random-value

HOST=0.0.0.0
PORT=8787
STATE_DIRECTORY=.data
STATIC_DIRECTORY=dist/web
