{
  "name": "did-controller-wallet-demo",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "publisher": "tsx publisher/cli.ts",
    "companion": "tsx --env-file=.env companion/cli.ts",
    "web:dev": "vite --config web/vite.config.mts",
    "web:build": "vite build --config web/vite.config.mts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit && tsc -p publisher/tsconfig.json --noEmit && tsc -p companion/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "expo lint",
    "export:ios": "expo export --platform ios --output-dir dist",
    "check": "npm run test && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "2.2.0",
    "@scure/base": "2.2.0",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "^24.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.10",
    "@types/react-dom": "^19.1.11",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-preset-expo": "~54.0.9",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vite": "^8.2.0"
  }
}
